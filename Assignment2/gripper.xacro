<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:macro name="robot_gripper" params="gripper_span link2_length">

<!-- The gripper will be made up of a body and the 2 fingers; the gripper span will be 14cm so that we have some margin to grab the carton-->
        
    <link name="gripper_body">
      <visual>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <box size="0.10 0.18 0.04"/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
     
        <collision>
          <origin xyz="0 0 0.02" rpy="0 0 0"/>
          <geometry>
            <box size="0.10 0.18 0.04"/>
          </geometry>
        </collision>

        <!-- To find the moment of inertia of a rectangular box I consulted the following wikipedia page listing several moments of inertia: https://en.wikipedia.org/wiki/List_of_moments_of_inertia -->
        
        <inertial>
          <origin xyz="0 0 0.02" rpy="0 0 0"/>
          <mass value="0.5"/>
          <inertia
            ixx="${(0.5 / 12.0) * (0.18 * 0.18 + 0.04 * 0.04)}"
            ixy="0"
            ixz="0"
            iyy="${(0.5 / 12.0) * (0.10 * 0.10 + 0.04 * 0.04)}"
            iyz="0"
            izz="${(0.5 / 12.0) * (0.10 * 0.10 + 0.18 * 0.18)}"/>
        </inertial>
    </link>

<!-- The fingers are 2cm thick-->
    
    <link name="left_finger">
      <visual>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.02 0.12"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>
        
        <collision>
          <origin xyz="0 0 0.06" rpy="0 0 0"/>
          <geometry>
            <box size="0.025 0.02 0.12"/>
          </geometry>
        </collision>  

        <inertial>
          <origin xyz="0 0 0.06" rpy="0 0 0"/>
          <mass value="0.1"/>
          <inertia
            ixx="${(0.1 / 12.0) * (0.02 * 0.02 + 0.12 * 0.12)}"
            ixy="0"
            ixz="0"
            iyy="${(0.1 / 12.0) * (0.025 * 0.025 + 0.12 * 0.12)}"
            iyz="0"
            izz="${(0.1 / 12.0) * (0.025 * 0.025 + 0.02 * 0.02)}"/>
        </inertial>
    </link>


<!-- The fingers will conect to the gripper body through a primastic joint that allows them to move linearly towards one another (following the Y axis)-->

    
    <joint name="left_finger_joint" type="prismatic">
      <parent link="gripper_body"/>
      <child link="left_finger"/>
    
      <origin xyz="0 ${-(gripper_span / 2 + 0.01)} 0.04" rpy="0 0 0"/>
    
      <axis xyz="0 1 0"/>
    
      <limit lower="0" upper="0.05" effort="20" velocity="0.1"/>
    </joint>

    
    <link name="right_finger">
      <visual>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.02 0.12"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>
    
        <collision>
          <origin xyz="0 0 0.06" rpy="0 0 0"/>
          <geometry>
            <box size="0.025 0.02 0.12"/>
          </geometry>
        </collision>   
      
        <inertial>
          <origin xyz="0 0 0.06" rpy="0 0 0"/>
          <mass value="0.1"/>
          <inertia
            ixx="${(0.1 / 12.0) * (0.02 * 0.02 + 0.12 * 0.12)}"
            ixy="0"
            ixz="0"
            iyy="${(0.1 / 12.0) * (0.025 * 0.025 + 0.12 * 0.12)}"
            iyz="0"
            izz="${(0.1 / 12.0) * (0.025 * 0.025 + 0.02 * 0.02)}"/>
        </inertial>
    </link>



    
    <joint name="right_finger_joint" type="prismatic">
      <parent link="gripper_body"/>
      <child link="right_finger"/>
    
      <origin xyz="0 ${gripper_span / 2 + 0.01} 0.04" rpy="0 0 0"/>
    
      <axis xyz="0 -1 0"/>
    
      <limit lower="0" upper="0.05" effort="20" velocity="0.1"/>
    </joint>



<!-- Now that we have the fingers attached to the grippers body, we need to attach the body to the arm's 2nd link using a joint, which will be fixed to make it easier-->

        
    <joint name="wrist_joint" type="fixed">
      <parent link="arm_link2"/>
      <child link="gripper_body"/>
    
      <origin xyz="0 0 ${link2_length}" rpy="0 0 0"/>
    </joint>


    </xacro:macro>
</robot>